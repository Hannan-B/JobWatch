/*.json
!jobwatch/data/cities.json

# --- Python bytecode (regenerated on every run) ---
__pycache__/
*.pyc

# --- macOS clutter (also mildly info-leaky) ---
.DS_Store

# --- Editor settings ---
.vscode/
.idea/

# --- Secrets (you have none now, but never commit these) ---
.env
*.pem
*.key
